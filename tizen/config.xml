<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://mlayfer.com/maskhai2"
        version="1.5.2"
        viewmodes="maximized">
  <!-- MlayferTV2, not MlayferTV1. The old package is stuck on the television:
       it was signed with one certificate and every build since with another,
       and Tizen will not replace a package in place across that — while the set
       shows nothing in its app list to remove. A new package id is an
       installation the television has never seen, which is the way past it.
       The cost is that it is a different app as far as the set is concerned, so
       the saved source and the history start empty. Ten characters exactly is
       what Tizen allows. -->
  <tizen:application id="MlayferTV2.MaskHai" package="MlayferTV2" required_version="6.5"/>
  <content src="index.html"/>
  <icon src="icon.png"/>
  <name>טלוהים</name>
  <tizen:profile name="tv-samsung"/>
  <access origin="*" subdomains="true"/>
  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
  <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable" pointing-device-support="disable"/>
</widget>
